{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gemini-and-chatgpt.local/schemas/checkpoint.schema.json",
  "title": "gemini-and-chatgpt v2 Task Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "created_at", "reason", "lifecycle", "implementation", "verification", "delivery", "review", "blockers", "resume_hint"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "task_id": {"type": "string", "pattern": "^T-[0-9]{8}-[0-9]{3}-[a-z0-9][a-z0-9-]*$"},
    "created_at": {"type": "string", "format": "date-time"},
    "reason": {"enum": ["STATE_TRANSITION", "BLOCKED", "HUMAN_GATE", "RECOVERY", "MANUAL"]},
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_state", "previous_state", "resume_state"],
      "properties": {
        "current_state": {"$ref": "#/$defs/state"},
        "previous_state": {"anyOf": [{"$ref": "#/$defs/state"}, {"type": "null"}]},
        "resume_state": {"anyOf": [{"$ref": "#/$defs/state"}, {"type": "null"}]}
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "candidate_sha", "changed_files"],
      "properties": {
        "branch": {"type": ["string", "null"]},
        "candidate_sha": {"anyOf": [{"$ref": "#/$defs/fullSha"}, {"type": "null"}]},
        "changed_files": {"type": "array", "items": {"type": "string"}}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall_status", "candidate_sha", "evidence_ledger_path"],
      "properties": {
        "overall_status": {"enum": ["NOT_RUN", "PASS", "FAIL", "BLOCKED", "PARTIAL"]},
        "candidate_sha": {"anyOf": [{"$ref": "#/$defs/fullSha"}, {"type": "null"}]},
        "evidence_ledger_path": {"type": "string"}
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pr_number", "pr_url", "head_sha"],
      "properties": {
        "pr_number": {"type": ["integer", "null"], "minimum": 1},
        "pr_url": {"type": ["string", "null"], "format": "uri"},
        "head_sha": {"anyOf": [{"$ref": "#/$defs/fullSha"}, {"type": "null"}]}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["round", "max_rounds", "current_target_sha", "current_verdict", "approval_valid"],
      "properties": {
        "round": {"type": "integer", "minimum": 0},
        "max_rounds": {"type": "integer", "minimum": 1, "maximum": 20},
        "current_target_sha": {"anyOf": [{"$ref": "#/$defs/fullSha"}, {"type": "null"}]},
        "current_verdict": {"enum": [null, "APPROVED_TO_MERGE", "REQUEST_CHANGES", "NEEDS_HUMAN_DECISION"]},
        "approval_valid": {"type": "boolean"}
      }
    },
    "blockers": {"type": "array", "items": {"type": "object"}},
    "resume_hint": {"type": ["string", "null"]}
  },
  "$defs": {
    "fullSha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "state": {"enum": ["RECEIVED", "CLASSIFIED", "PLANNING", "PLAN_READY", "IMPLEMENTING", "VERIFYING", "PR_PREPARING", "REVIEWING", "FIXING", "RELEASE_GATE", "APPROVED", "BLOCKED", "HUMAN_DECISION", "REVIEW_LIMIT_REACHED", "FAILED", "ABORTED"]}
  }
}
