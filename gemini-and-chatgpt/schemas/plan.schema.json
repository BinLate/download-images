{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gemini-and-chatgpt.local/schemas/plan.schema.json",
  "title": "gemini-and-chatgpt v2 Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "goal",
    "in_scope",
    "out_of_scope",
    "constraints",
    "assumptions",
    "acceptance_criteria",
    "risk_level",
    "risk_notes",
    "work_items",
    "release_constraints"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "task_id": {
      "type": "string",
      "pattern": "^T-[0-9]{8}-[0-9]{3}-[a-z0-9][a-z0-9-]*$"
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risk_level": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "work_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "owner_role",
          "objective",
          "scope_hints",
          "dependencies",
          "verification",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^W[1-9][0-9]*$"
          },
          "owner_role": {
            "enum": [
              "PLANNER",
              "ARCHITECT",
              "BUILDER",
              "VERIFIER",
              "DELIVERY_GATE"
            ]
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "scope_hints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^W[1-9][0-9]*$"
            },
            "uniqueItems": true
          },
          "verification": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "enum": [
              "PENDING",
              "READY",
              "IN_PROGRESS",
              "VERIFYING",
              "DONE",
              "BLOCKED",
              "SKIPPED_WITH_REASON"
            ]
          },
          "skip_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "SKIPPED_WITH_REASON"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "skip_reason"
              ],
              "properties": {
                "skip_reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    },
    "release_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "in_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "out_of_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risk_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
