{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gemini-and-chatgpt.local/schemas/verification-evidence.schema.json",
  "title": "gemini-and-chatgpt v2 Verification Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "candidate_sha", "check_id", "category", "required", "status", "started_at", "completed_at", "exit_code", "command", "scope", "summary", "reason"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "task_id": {"type": "string", "pattern": "^T-[0-9]{8}-[0-9]{3}-[a-z0-9][a-z0-9-]*$"},
    "candidate_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "check_id": {"type": "string", "minLength": 1},
    "category": {"enum": ["LINT", "TYPECHECK", "FOCUSED_TEST", "REGRESSION_TEST", "BUILD", "INTEGRATION_SMOKE", "CUSTOM"]},
    "required": {"type": "boolean"},
    "status": {"enum": ["PASS", "FAIL", "BLOCKED", "SKIPPED"]},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "exit_code": {"type": ["integer", "null"]},
    "command": {"type": ["string", "null"]},
    "scope": {"type": "array", "items": {"type": "string"}},
    "summary": {"type": "string"},
    "reason": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"enum": ["FAIL", "BLOCKED", "SKIPPED"]}}, "required": ["status"]},
      "then": {"properties": {"reason": {"type": "string", "minLength": 1}}, "required": ["reason"]}
    }
  ]
}
